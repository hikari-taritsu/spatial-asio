<Window x:Class="SpatialASIO.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpatialASIO" Title="Spatial ASIO" Width="1280" Height="840" MinWidth="1020" MinHeight="800" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource Graphite}" TextElement.Foreground="{StaticResource Ink}" TextElement.FontFamily="{StaticResource InterfaceFont}" TextElement.FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0"><DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{StaticResource Accent}" FontSize="27" Margin="0,0,12,0"/><TextBlock Text="Spatial ASIO" FontFamily="{StaticResource TitleFont}" FontSize="23"/><TextBlock Text="原生空间音频工作台" Foreground="{StaticResource Muted}" Margin="20,0,0,0" FontSize="12"/></StackPanel><TextBlock x:Name="TopStatus" Text="尚未启动" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel></Border>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="原生对象" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="CaptureState" Text="等待捕获" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource Muted}"/>
      <StackPanel Grid.Column="2"><TextBlock Text="点声源渲染" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="RenderState" Text="OAR · 9.1.6" Margin="0,5,0,0" FontFamily="{StaticResource InterfaceFont}"/></StackPanel><TextBlock Grid.Column="3" Text="→" Foreground="{StaticResource Muted}"/>
      <StackPanel Grid.Column="4"><TextBlock Text="ASIO 输出" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="OutputState" Text="尚未打开驱动" Margin="0,5,0,0"/></StackPanel>
      <Button x:Name="StartButton" Grid.Column="5" Content="开始捕获" Background="{StaticResource Ink}" Foreground="{StaticResource Inset}" Click="ToggleCapture" Margin="10,1,0,1"/>
    </Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Grid Margin="24,20,24,18"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>
        <DockPanel><StackPanel Orientation="Horizontal"><Button Content="空间监视" Click="ShowMonitor" Padding="12,5"/><Button Content="声道路由" Click="ShowRouting" Padding="12,5" Margin="8,0,0,0"/><Button Content="诊断日志" Click="ShowDiagnostics" Padding="12,5" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="LayoutCount" Text="16 CHANNELS" Foreground="{StaticResource Muted}" FontFamily="{StaticResource InterfaceFont}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
        <local:StageView x:Name="Stage" Grid.Row="1" Margin="0,12,0,18"/>
        <Grid x:Name="RoutingPage" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,18"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="编辑物理输出与微调。修改后保存，下一次启动生效。" Foreground="{StaticResource Muted}" FontSize="12"/><DataGrid x:Name="Routes" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="扬声器" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="ASIO 物理通道" Binding="{Binding Physical,ValidatesOnExceptions=True}" Width="*"/><DataGridTextColumn Header="微调 / dB" Binding="{Binding Trim,ValidatesOnExceptions=True}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
        <TextBox x:Name="LogView" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,18" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource InterfaceFont}" FontSize="12"/>
        <Border Grid.Row="2" Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="16,12"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions><DockPanel><TextBlock Text="输出电平" FontWeight="SemiBold"/><TextBlock Text="dBFS · 主音量与微调之后，硬件限幅之前" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><local:MeterView x:Name="Meters" Grid.Row="1"/><DockPanel Grid.Row="2"><TextBlock x:Name="ObjectInfo" Text="0 个对象 · 0 个数据包" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="DropInfo" Text="欠载 0 帧" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/></DockPanel></Grid></Border>
      </Grid>
      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,18">
        <TextBlock Text="ASIO 硬件输出" FontSize="18" FontFamily="{StaticResource InterfaceFont}" Margin="0,0,0,16"/>
        <StackPanel x:Name="ConfigurationControls">
          <TextBlock Text="驱动程序" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="DriverBox" DisplayMemberPath="name" AutomationProperties.Name="ASIO 驱动程序"/>
          <UniformGrid Columns="3" Margin="0,10,0,20"><Button Content="刷新" Click="RefreshDrivers" Padding="3,7" Margin="0,0,6,0"/><Button Content="检测" Click="ProbeDriver" Padding="3,7" Margin="0,0,6,0"/><Button Content="驱动面板" Click="OpenDriverPanel" Padding="3,7"/></UniformGrid>
          <TextBlock x:Name="DriverInfo" Text="检测驱动以查看输出通道与缓冲范围。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"/>
          <TextBlock Text="扬声器布局" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="LayoutBox" SelectionChanged="LayoutChanged" AutomationProperties.Name="扬声器布局"/>
          <TextBlock Text="内部 48 kHz · 点声源前视 10.67 ms" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,20"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="设备采样率 / Hz" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="RateBox" Text="48000" AutomationProperties.Name="ASIO 设备采样率"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="缓冲 / 帧，0 自动" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="BufferBox" Text="0" AutomationProperties.Name="ASIO 缓冲帧数"/></StackPanel></Grid>
          <DockPanel Margin="0,12,0,20"><TextBlock Text="捕获缓冲 / ms" Foreground="{StaticResource Muted}" FontSize="12"/><TextBox x:Name="PrebufferBox" Text="32" Width="74" HorizontalAlignment="Right" ToolTip="8–500 ms。降低后观察欠载、迟到帧和丢包；出现增长则提高缓冲。" AutomationProperties.Name="捕获缓冲毫秒"/></DockPanel>
          <TextBlock x:Name="LatencyInfo" Text="32 ms 为默认捕获缓冲；出现间断时提高到 60 ms。运行后显示各段缓冲与耗时。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,0,0,16"/>
          <Button Content="保存配置" Click="SaveConfiguration"/>
        </StackPanel>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,24,0,20"/>
        <DockPanel><TextBlock Text="主输出音量"/><TextBlock x:Name="GainLabel" Text="−12.0 dB" FontFamily="{StaticResource InterfaceFont}" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="GainSlider" Minimum="-60" Maximum="0" Value="-12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="GainChanged" Margin="0,16,0,8" AutomationProperties.Name="主输出音量，分贝"/>
        <DockPanel><TextBlock Text="−60 dB" Foreground="{StaticResource Muted}" FontFamily="{StaticResource InterfaceFont}" FontSize="11"/><TextBlock Text="0 dB" Foreground="{StaticResource Muted}" FontFamily="{StaticResource InterfaceFont}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
        <Button x:Name="MuteButton" Content="静音" Click="ToggleMute" Margin="0,12,0,0"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,24,0,20"/>
        <TextBlock Text="开始之前" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="在游戏实际使用的播放设备上启用 Windows Sonic，再重新启动游戏。此处选择的 ASIO 是最终扬声器输出。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19"/>
        <Button Content="检查捕获兼容性" Click="CheckCompatibility" Margin="0,16,0,8"/><Button Content="Windows 声音设置" Click="OpenSoundSettings"/>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,0"><DockPanel><Button DockPanel.Dock="Right" Content="打开日志目录" Click="OpenLogs" Padding="10,4" Margin="12,4,0,4"/><TextBlock x:Name="Footer" Text="仅原生对象捕获 → 点声源渲染 → ASIO  /  0.1.1 预览版" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
</Window>
